# GitHub authentication (token needs repository read access)
GITHUB_USERNAME=githubUsername
GITHUB_TOKEN=githubToken

# Repository configuration
FORK_REPO=https://github.com/your-account/your-kde-linux-fork.git
UPSTREAM_REPO=https://invent.kde.org/kde-linux/kde-linux.git
TARGET_BRANCH=your-build-branch
UPSTREAM_BRANCH=master

# Automatic build/check interval in seconds (604800 = 7 days)
POLL_INTERVAL=604800

# WebUI authentication. Change both before first startup.
MANAGER_USERNAME=admin
MANAGER_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32

# GPG signing identity
GPG_KEY_NAME="Custom KDE Linux"
GPG_KEY_EMAIL=
GPG_KEY_EXPIRE=0
GPG_EXPORT_DIR=./key-export
GPG_PUBLIC_KEY_FILE=kde-linux-signing-public.asc

# Initial retention defaults; editable in WebUI after first boot
DEFAULT_RETENTION=4
DEFAULT_HISTORY_RETENTION=100
# Optional: select an existing key by fingerprint; blank uses the saved key
GPG_SIGNING_KEY=

# Optional defaults (also editable in the WebUI)
